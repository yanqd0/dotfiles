# npm 注册表源。
# 当前: 腾讯云
#   腾讯云: https://mirrors.cloud.tencent.com/npm/
# 备选:
#   阿里云: https://registry.npmmirror.com/
#   清华:   https://registry.npmmirror.com/  (npmmirror 为阿里/清华共建)
#   华为云: https://mirrors.huaweicloud.com/repository/npm/
#   中科大: https://npmreg.proxy.ustclug.org/
#   npmjs:  https://registry.npmjs.org/
registry=https://mirrors.cloud.tencent.com/npm/

# ── 行为设置 ──────────────────────────────────
package-lock=true
fetch-timeout=300000
fetch-retries=3
loglevel=warn
prefer-offline=true
git-tag-version=false
engine-strict=true

# ── 二进制镜像 ────────────────────────────────
# node-sass 已不兼容 Node 24，以下镜像保留备查
# sass_binary_site=https://mirrors.huaweicloud.com/node-sass
# phantomjs 已废弃（推荐 Playwright/Puppeteer）
# phantomjs_cdnurl=https://mirrors.huaweicloud.com/phantomjs
chromedriver_cdnurl=https://mirrors.huaweicloud.com/chromedriver
# operadriver 使用极少，按需启用
# operadriver_cdnurl=https://mirrors.huaweicloud.com/operadriver
electron_mirror=https://mirrors.huaweicloud.com/electron/
python_mirror=https://mirrors.huaweicloud.com/python

# TODO: 考虑通过环境变量（NPM_CONFIG_REGISTRY 等）统一管理镜像和
# 超时配置，减少多机 .npmrc 文件的重复维护。
